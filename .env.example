# Copy to .env.local (never committed).

# AI recipes: used by the local server (`npm run dev` / `npm start`) for /api/generate-recipe.
# On Vercel, set it in Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Accounts with end-to-end encrypted sync (optional): your Supabase project, see docs/INSTALLATION.md.
# The anon key is public by design: the `vaults` table only lets each user reach their own encrypted row.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Optional: another endpoint for the AI (for example the Supabase function variant).
# VITE_RECIPE_AI_URL=https://xxxx.supabase.co/functions/v1/generate-recipe

# Optional: another endpoint for "Où les trouver ?" (for example the Supabase function). No key needed.
# VITE_STORES_URL=https://xxxx.supabase.co/functions/v1/stores
