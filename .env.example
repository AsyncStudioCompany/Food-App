# Copy to .env.local (never committed).

# Server side: used by `npm run dev` / `npm run preview` to serve /api/generate-recipe.
# Online (later), set it as a Supabase secret instead: supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# Client side (optional, only for the Supabase variant): the function URL and anon key.
# VITE_RECIPE_AI_URL=https://<project>.supabase.co/functions/v1/generate-recipe
# VITE_SUPABASE_ANON_KEY=
